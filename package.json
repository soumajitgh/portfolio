{
  "name": "portfolio-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "nx run web:build",
    "dev": "pnpm run dev:deps && pnpm run dev:apps",
    "dev:apps": "nx run-many --target=dev --projects=web,ssh --parallel=2",
    "dev:deps": "docker compose up --detach --wait postgres && nx run web:migrate",
    "dev:web": "pnpm run dev:deps && nx run web:dev",
    "dev:ssh": "nx run ssh:dev",
    "lint": "nx run web:lint",
    "start": "nx run web:start",
    "test": "nx run web:test",
    "web:build": "nx run web:build",
    "web:docker": "nx run web:docker",
    "ssh:build": "nx run ssh:build",
    "ssh:docker": "nx run ssh:docker"
  },
  "devDependencies": {
    "nx": "23.1.0"
  },
  "engines": {
    "node": "^20.9.0 || >=22.0.0",
    "pnpm": "^11"
  }
}
