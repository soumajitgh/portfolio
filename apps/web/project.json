{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.next"],
      "inputs": [
        "production",
        "^production",
        { "env": "NEXT_PUBLIC_SITE_URL" },
        { "env": "NEXT_PUBLIC_TURNSTILE_SITE_KEY" },
        { "env": "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN" },
        { "env": "NEXT_PUBLIC_POSTHOG_HOST" },
        { "env": "R2_PUBLIC_URL" }
      ],
      "options": {
        "command": "pnpm build",
        "cwd": "apps/web"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm dev",
        "cwd": "apps/web",
        "forwardAllArgs": true
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm start",
        "cwd": "apps/web",
        "forwardAllArgs": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm lint",
        "cwd": "apps/web"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm test",
        "cwd": "apps/web"
      }
    },
    "test:int": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm test:int",
        "cwd": "apps/web"
      }
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm test:e2e",
        "cwd": "apps/web"
      }
    },
    "generate:types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm generate:types",
        "cwd": "apps/web"
      }
    },
    "generate:importmap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm generate:importmap",
        "cwd": "apps/web"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm payload migrate",
        "cwd": "apps/web"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm seed",
        "cwd": "apps/web"
      }
    },
    "docker": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker build --file apps/web/Dockerfile --tag portfolio-web ."
      }
    }
  }
}
