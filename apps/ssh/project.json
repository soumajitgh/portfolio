{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ssh",
  "projectType": "application",
  "sourceRoot": "apps/ssh",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "go build -trimpath -o dist/ssh .",
        "cwd": "apps/ssh"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "go run .",
        "cwd": "apps/ssh"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "./dist/ssh",
        "cwd": "apps/ssh"
      }
    },
    "docker": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker build --file apps/ssh/Dockerfile --tag portfolio-ssh ."
      }
    }
  }
}
